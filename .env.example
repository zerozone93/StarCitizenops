# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starcitizenops?schema=public"
# Set this only when you intentionally want to run the destructive seed against a non-local DB.
ALLOW_REMOTE_SEED="false"

# Auth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Cron jobs
CRON_SECRET="replace-with-a-long-random-secret"

# Mission intelligence + weekly live refresh controls
MISSION_INTELLIGENCE_ENABLED="true"
MISSION_INTELLIGENCE_MIN_INTERVAL_DAYS="6"
WEEKLY_DATA_REFRESH_ENABLED="true"
WEEKLY_MISSION_SEED_SYNC_ENABLED="false"

# Feature flags
ENABLE_2FA="false"

# AI provider selection: gemini | groq | openrouter | openai
AI_PROVIDER="gemini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# Discord Bot / OAuth Integration
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
NEXT_PUBLIC_DISCORD_CLIENT_ID=""

# Mail
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
