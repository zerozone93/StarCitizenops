# Logistics module environment placeholders
LOGISTICS_ENABLED=true
LOGISTICS_STORAGE_URL=
LOGISTICS_STORAGE_ACCESS_KEY=
LOGISTICS_STORAGE_SECRET_KEY=
LOGISTICS_STORAGE_BUCKET=
LOGISTICS_AI_PROVIDER=gemini
LOGISTICS_AI_API_KEY=
LOGISTICS_GOOGLE_CLIENT_ID=
LOGISTICS_GOOGLE_CLIENT_SECRET=
LOGISTICS_GOOGLE_REDIRECT_URI=
LOGISTICS_DISCORD_BOT_TOKEN=
LOGISTICS_DISCORD_PUBLIC_KEY=
LOGISTICS_DISCORD_APPLICATION_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starops
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Star Citizen Ops auth/permission forwarding
STAROPS_DEFAULT_ROLE=LOGISTICS_ADMIN
STAROPS_DEFAULT_USER_ID=scops-user-001
STAROPS_DEFAULT_ORG_ID=org-demo-01
STAROPS_PERMISSION_BYPASS=false

# Optional comma-separated explicit permissions fallback for local testing
STAROPS_DEFAULT_PERMISSIONS=logistics.tool.access,logistics.view,logistics.settings.manage,logistics.admins.assign
